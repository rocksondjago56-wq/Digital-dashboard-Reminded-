# Database and session settings
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE"
JWT_SECRET="replace-with-a-long-random-secret"
CLIENT_ORIGIN="https://digital-dashboard-reminded.vercel.app"
SMTP_HOST="smtp.example.edu.gh"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="portal@ttu.edu.gh"
SMTP_PASS="replace-with-your-smtp-password"
SMTP_FROM="TTU Graphic Design Portal <portal@ttu.edu.gh>"

# Keep these private. Set different strong values in the deployed backend.
LECTURER_REGISTRATION_CODE="replace-with-a-strong-lecturer-code"
ADMIN_REGISTRATION_CODE="replace-with-a-different-strong-admin-code"

# Comma-separated email addresses permitted to use the test-only role manager.
TEST_ROLE_MANAGER_EMAILS="your-google-email@example.com"

# Server-only key from Supabase Project Settings -> API. Never expose this in Vite or GitHub.
SUPABASE_SERVICE_ROLE_KEY="replace-with-supabase-service-role-key"

# Presentation-only shortcut: permits code 0000 for new lecturer/admin accounts.
# Set to false before real-world use; real administrator-generated codes still work.
DEMO_MODE="false"
