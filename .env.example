# Public backend URL used by the Vite frontend.
# Leave unset for local development, which uses http://localhost:3001/api.
VITE_API_BASE="https://your-backend.example.com/api"

# Public portal URL used as the Google OAuth return address in deployed builds.
# Set this in Vercel to your actual https://...vercel.app URL.
VITE_PUBLIC_APP_URL="https://your-portal.vercel.app"
